# .vercelignore for PKSK Simulator
# Prevent bloated assets & development files from consuming Vercel Deployment Storage

# 1. Python scripts & test scratch files
scratch/**
scripts/**
*.py
*.pyc
__pycache__/

# 2. Local Documentation & Planning Files
*.md
!README.md
graft/**
.agents/**

# 3. Local OS & IDE artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/

# 4. System backups
*.bak
*.sql
*.tmp
